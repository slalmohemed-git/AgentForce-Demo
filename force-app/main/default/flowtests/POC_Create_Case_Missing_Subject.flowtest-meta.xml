        <parameters><leftValueReference>Mode</leftValueReference><type>InputVariable</type><value><stringValue>CREATE</stringValue></value></parameters><parameters><leftValueReference>SubmissionId</leftValueReference><type>InputVariable</type><value><stringValue>FT-NOSUBJ-0001</stringValue></value></parameters><parameters><leftValueReference>Description</leftValueReference><type>InputVariable</type><value><stringValue>Test description</stringValue></value></parameters><parameters><leftValueReference>Category</leftValueReference><type>InputVariable</type><value><stringValue>General Inquiry</stringValue></value></parameters>
    </testPoints>
    <testPoints>
        <assertions><conditions><leftValueReference>ResultCode</leftValueReference><operator>EqualTo</operator><rightValue><stringValue>VALIDATION</stringValue></rightValue></conditions></assertions><assertions><conditions><leftValueReference>Message</leftValueReference><operator>EqualTo</operator><rightValue><stringValue>Subject is required.</stringValue></rightValue></conditions></assertions>
        <elementApiName>Finish</elementApiName>
    </testPoints>
</FlowTest>
