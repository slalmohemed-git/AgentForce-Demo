    <decisions>
        <name>Is_Token_Valid</name>
        <label>Is the verification still valid?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_Not_Verified</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Verified</defaultConnectorLabel>
        <rules>
            <name>Token_Valid</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varB_TokenValid</leftValueReference>
                <operator>EqualTo</operator>
