<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <description>One-time identity verification codes emailed to UC Portal customers by the UC Assist agent. Holds only hashes, never the plain code. Audit trail for US-1 and US-6.</description>
    <enableActivities>false</enableActivities>
    <enableHistory>false</enableHistory>
    <enableReports>true</enableReports>
    <enableSearch>false</enableSearch>
    <externalSharingModel>Private</externalSharingModel>
    <label>Verification Code</label>
    <nameField>
        <displayFormat>VC-{00000}</displayFormat>
        <label>Verification Code Number</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Verification Codes</pluralLabel>
    <sharingModel>Private</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
