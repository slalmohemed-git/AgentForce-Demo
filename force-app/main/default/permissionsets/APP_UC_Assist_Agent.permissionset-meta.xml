<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Lets the UC Assist agent user run its actions: Apex classes for Send, Check, Redeem and Reset, and the SUB - Reset Portal Password flow. Spec v1.0 Permissions.</description>
    <classAccesses>
        <apexClass>CheckVerificationCode</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>RedeemVerificationToken</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>ResetUserPassword</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>SendVerificationCode</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>VerificationCodeService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <flowAccesses>
        <enabled>true</enabled>
        <flow>SUB_Reset_Portal_Password</flow>
    </flowAccesses>
    <hasActivationRequired>false</hasActivationRequired>
    <label>APP - UC Assist Agent</label>
</PermissionSet>
